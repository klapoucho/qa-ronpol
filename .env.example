# Base URL of the Rolnopol app under test (http or https).
BASE_URL=http://localhost:3000
# Run profile: local or ci. Selects retries, workers, reporters and timeouts.
TEST_ENV=local
# App version the suite was written for. A different version only logs a warning.
EXPECTED_APP_VERSION=1.126.0
# Set to true to restore the app's base database before the run. Wipes shared data.
RESET_DB=false
