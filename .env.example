# Environment to run against: dev (the local app, default) or staging. Each has its address in
# src/config/environments.ts.
APP_ENV=dev
# Overrides the address of the chosen environment (http or https). Leave it unset to use the
# environment's own address; a value here applies to every APP_ENV.
# BASE_URL=http://localhost:3000
# Run profile: local or ci. Selects retries, workers, reporters and timeouts.
TEST_ENV=local
# App version the suite was written for. A different version only logs a warning.
EXPECTED_APP_VERSION=1.126.0
# Sent as X-Synthetic-Token so test traffic skips the app's API rate limit. Must match the value the
# app was started with (compose.yaml reads this file too); after changing it, the author recreates the app.
SYNTHETIC_TOKEN=local-synthetic-token
# Set to true to restore the app's base database before the run. Wipes shared data.
RESET_DB=false
