{
  "name": "qa-ronpol",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "imports": {
    "#src/*": "./src/*"
  },
  "scripts": {
    "test": "playwright test",
    "test:api": "playwright test --project=api",
    "test:ui": "playwright test --project=ui",
    "test:ui-mocked": "playwright test --project=ui-mocked",
    "test:ui-ledger": "playwright test --project=ui-ledger --no-deps",
    "test:smoke": "playwright test --grep @smoke",
    "test:staging": "APP_ENV=staging playwright test",
    "report": "playwright show-report",
    "coverage:api": "node scripts/api-coverage.ts --area Marketplace",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check && playwright test --list",
    "app:up": "docker compose up --detach --wait",
    "app:down": "docker compose down",
    "app:logs": "docker compose logs --follow",
    "app:reset": "node scripts/app-reset.ts",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@eslint/js": "10.0.1",
    "@faker-js/faker": "10.6.0",
    "@playwright/test": "1.65.1",
    "@tsconfig/node26": "26.0.2",
    "@types/node": "26.6.10",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-playwright": "2.12.2",
    "husky": "9.1.7",
    "lint-staged": "17.6.2",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0"
  },
  "lint-staged": {
    "*.{ts,js}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,yml,yaml}": "prettier --write"
  },
  "dependencies": {
    "zod": "4.6.7"
  }
}
